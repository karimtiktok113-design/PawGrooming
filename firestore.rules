rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Client profiles collection
    match /client_profiles/{profileId} {
      allow read, write: if true;
    }

    // Admin configuration collection
    match /admin_config/{adminId} {
      allow read, write: if true;
    }

    // Admin broadcasts and push notifications collection
    match /admin_broadcasts/{notifId} {
      allow read, write: if true;
    }

    // Test connection document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
